{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Laplusdestiny/cmdpal-station-countdown/schemas/stations.schema.json",
  "title": "Station Countdown stations",
  "description": "stations.yaml の形式（設計書 §4.2、§6.3）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "settings": {
      "description": "全体の設定。どの項目も省略でき、省略した項目は既定値になる",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refreshIntervalDays": {
          "description": "時刻表を自動で再取得する間隔（日）",
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 7
        },
        "departuresListLimit": {
          "description": "一覧に出す最大件数",
          "type": "integer",
          "minimum": 5,
          "maximum": 100,
          "default": 30
        }
      }
    },
    "stations": {
      "type": "array",
      "items": { "$ref": "#/$defs/station" }
    },
    "dayTypeOverrides": {
      "description": "特定の日のダイヤ種別を上書きする",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "dayType"],
        "properties": {
          "date": {
            "description": "営業日の日付（例: 2026-12-31）",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dayType": { "$ref": "#/$defs/dayType" }
        }
      }
    }
  },
  "$defs": {
    "dayType": {
      "enum": ["weekday", "saturday", "holiday", "saturdayHoliday"]
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "directionLabel", "walkMinutes", "source"],
      "properties": {
        "id": {
          "description": "半角英小文字・数字と「-」。64 文字以内。重複不可",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": { "$ref": "#/$defs/nonBlank", "description": "駅の表示名" },
        "directionLabel": { "$ref": "#/$defs/nonBlank", "description": "方面の表示名" },
        "walkMinutes": {
          "description": "家から駅までの徒歩の分数",
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "const": "file" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "stationPageUrl", "line", "direction"],
              "properties": {
                "type": { "const": "hankyu" },
                "stationPageUrl": {
                  "description": "阪急公式サイトの駅ページの URL",
                  "type": "string",
                  "pattern": "^https://www\\.hankyu\\.co\\.jp/"
                },
                "line": { "$ref": "#/$defs/nonBlank", "description": "路線（例: 宝塚線）" },
                "direction": { "$ref": "#/$defs/nonBlank", "description": "方面（例: 宝塚方面）" }
              }
            }
          ]
        }
      }
    }
  }
}
